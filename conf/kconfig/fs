config fs_procfs
  prompt "Include procfs filesystem"
  bool
  default y

config fs_sysfs
  prompt "Include sysfs filesystem"
  bool
  default y

config fs_max_file_descriptors
  prompt "Maximum file descriptors"
  hex
  default 0x10000

config fs_buffer_cache_size
  prompt "Buffer cache size"
  int
  default 256

config fs_9p
  prompt "Include 9P2000.L filesystem client"
  bool
  default n

config fs_9p_tcp
  prompt "Include 9P TCP transport"
  depends on fs_9p && networking_stack
  bool
  default n
