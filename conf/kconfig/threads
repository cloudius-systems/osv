config preempt
  prompt "Enable preemption"
  def_bool $(shell,grep -q ^conf_preempt=1 conf/base.mk && echo y || echo n)

config lazy_stack
  prompt "Use lazy stack"
  def_bool $(shell,grep -q ^conf_lazy_stack=1 conf/base.mk && echo y || echo n)

config fork
  prompt "Include fork()/vfork() support (thread-backed, off by default)"
  bool
  default n
  help
    Enable OSv's thread-backed fork()/vfork()/execve()/waitpid() emulation.
    A forked child is a new OSv thread that resumes at the fork() call site on
    a private copy of the caller's stack; the child still SHARES the parent's
    heap and global variables (OSv remains a single-address-space unikernel -
    there is no per-child memory isolation).  See documentation/fork.md for
    exactly what works and what does not.  It is OFF by default: with this
    disabled, none of the fork code is compiled in and OSv behaves exactly as
    before (fork() returns ENOSYS).  Enable it only for workloads that require
    fork() (e.g. fork()+exec() to spawn a helper program).

config lazy_stack_invariant
  prompt "Check lazy stack invariant"
  def_bool $(shell,grep -q ^conf_lazy_stack_invariant=1 conf/base.mk && echo y || echo n)

config threads_default_kernel_stack_size
  prompt "Kernel thread default stack size"
  int
  default 65536

config threads_default_pthread_stack_size
  prompt "Pthread thread default stack size"
  hex
  default 0x100000

if $(arch) = aarch64
config threads_default_exception_stack_size
  prompt "Thread default exception stack size"
  hex
  default 0x10000 #Minimum 0x9000 when clone* syscall enabled
endif

if $(arch) = x64
config interrupt_stack_size
  prompt "Interrupt stack size"
  hex
  default $(shell,if [ $mode = "debug" ]; then echo 0x2000 ; else echo 0x1000; fi)

config syscall_stack_size
  prompt "Syscall stack size"
  hex
  default $(shell,if [ $mode = "debug" ]; then echo 0x2000 ; else echo 0x800; fi)
endif
