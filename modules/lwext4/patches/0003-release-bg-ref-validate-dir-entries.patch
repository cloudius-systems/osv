+			     ext4_lblk_t iblock, ext4_fsblk_t *fblock)
+{
+	/* support_unwritten: we handle the 0 (hole) result ourselves */
+	return ext4_fs_get_inode_dblk_idx(inode_ref, iblock, fblock, true);
+}
